# Copy to /etc/endcontrol/endcontrol.env; never commit the populated file.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://endcontrol.example.com
BETTER_AUTH_URL=https://endcontrol.example.com
DATABASE_URL=mysql://endcontrol_app:URL_ENCODED_PASSWORD@127.0.0.1:3306/endcontrol_cms
BETTER_AUTH_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
CMS_MEDIA_DIR=/var/lib/endcontrol/media
